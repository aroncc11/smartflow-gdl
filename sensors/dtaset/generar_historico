# ─────────────────────────────────────────────────────────────
# FACTORES
# ─────────────────────────────────────────────────────────────
FACTORES_HORA = {
    0: 0.05,  1: 0.04,  2: 0.03,  3: 0.03,
    4: 0.04,  5: 0.10,  6: 0.35,  7: 0.85,
    8: 1.00,  9: 0.80, 10: 0.55, 11: 0.60,
   12: 0.70, 13: 0.65, 14: 0.55, 15: 0.60,
   16: 0.75, 17: 0.90, 18: 0.95, 19: 1.00,
   20: 0.80, 21: 0.55, 22: 0.35, 23: 0.15,
}

FACTORES_DIA = {
    0: 0.95, 1: 1.00, 2: 1.00,
    3: 0.98, 4: 0.95, 5: 0.80, 6: 0.60,
}

FACTORES_VELOCIDAD_CLIMA = {
    "clear": 1.00, "cloudy": 0.95,
    "rain":  0.75, "heavy_rain": 0.55,
}

FACTORES_VOLUMEN_CLIMA = {
    "clear": 1.00, "cloudy": 1.00,
    "rain":  0.85, "heavy_rain": 0.65,
}

TIPOS_INCIDENTE = [
    "Accidente vehicular",
    "Cierre vial por obra",
    "Manifestacion",
    "Vehiculo descompuesto",
    "Evento masivo cercano",
]

CLIMAS = ["clear", "cloudy", "rain", "heavy_rain"]


# ─────────────────────────────────────────────────────────────
# GENERADOR DE LECTURA HISTORICA CON RUIDO REALISTA
# ─────────────────────────────────────────────────────────────
def generar_lectura(config: dict, timestamp: datetime, clima: str) -> dict:
    hora = timestamp.hour
    dia  = timestamp.weekday()

    factor_hora  = FACTORES_HORA[hora]
    factor_dia   = FACTORES_DIA[dia]
    factor_clima = FACTORES_VOLUMEN_CLIMA[clima]

    # Incidente aleatorio 2%
    incidente = random.random() < 0.02
    detalle   = random.choice(TIPOS_INCIDENTE) if incidente else None
    factor_i  = 1.25 if incidente else 1.0

    base = config["volumen_pico"] if factor_hora >= 0.80 \
           else config["volumen_normal"]

    vehiculos = (base * factor_hora * factor_dia *
                 factor_clima * factor_i) / 120

    # Ruido aumentado a +-15% para mayor variabilidad
    vehiculos = max(0, round(vehiculos * random.gauss(1.0, 0.15)))

    capacidad_30s   = config["volumen_pico"] / 120
    ratio           = min(vehiculos / max(capacidad_30s, 1), 1.0)
    vel_libre       = config["velocidad_libre"]
    factor_vel_clim = FACTORES_VELOCIDAD_CLIMA[clima]

    velocidad = vel_libre * (1 - 0.85 * ratio) * factor_vel_clim

    # Ruido en velocidad aumentado a +-15%
    velocidad = max(5.0, round(velocidad * random.gauss(1.0, 0.15), 1))

    # ── Congestion con ruido realista ──────────────────────
    # Zona claramente libre — mayormente LOW pero con casos ambiguos
    if velocidad > 40:
        congestion = random.choices(
            ["low", "medium"],
            weights=[0.93, 0.07]
        )[0]
    # Zona libre-media — predomina LOW con algo de MEDIUM
    elif velocidad > 35:
        congestion = random.choices(
            ["low", "medium"],
            weights=[0.80, 0.20]
        )[0]
    # Zona gris — puede ser cualquiera
    elif velocidad > 20:
        congestion = random.choices(
            ["low", "medium", "high"],
            weights=[0.10, 0.78, 0.12]
        )[0]
    # Zona media-alta — predomina MEDIUM con algo de HIGH
    elif velocidad > 15:
        congestion = random.choices(
            ["medium", "high"],
            weights=[0.75, 0.25]
        )[0]
    # Zona claramente congestionada — mayormente HIGH
    else:
        congestion = random.choices(
            ["medium", "high"],
            weights=[0.12, 0.88]
        )[0]

    is_peak = hora in range(7, 10) or hora in range(17, 21)

    return {
        "intersection_id":   config["id"],
        "intersection_name": config["nombre"],
        "lat":               config["lat"],
        "lon":               config["lon"],
        "timestamp":         timestamp,
        "vehicles_count":    vehiculos,
        "avg_speed_kmh":     velocidad,
        "congestion_level":  congestion,
        "incident_flag":     incidente,
        "incident_detail":   detalle,
        "weather":           clima,
        "hour_of_day":       hora,
        "day_of_week":       dia,
        "is_peak_hour":      is_peak,
        "historical_avg":    round(
            config["volumen_normal"] * FACTORES_HORA[hora] / 120, 1
        ),
    }


# ─────────────────────────────────────────────────────────────
# BORRAR DATOS ANTERIORES
# ─────────────────────────────────────────────────────────────
def limpiar_tabla():
    db = SessionLocal()
    try:
        total = db.query(TrafficReadingDB).count()
        print(f"  Registros actuales en Supabase: {total}")
        confirmacion = input("  Borrar todos los registros anteriores? (s/n): ")
        if confirmacion.lower() == "s":
            db.query(TrafficReadingDB).delete()
            db.commit()
            print("  Tabla limpiada correctamente")
        else:
            print("  Conservando registros anteriores")
    finally:
        db.close()


# ─────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────
def generar_dataset(dias: int = 14, registros_por_hora: int = 6):
    """
    Genera datos historicos de los ultimos N dias.
    registros_por_hora: lecturas por hora por interseccion
    """
    db = SessionLocal()

    fecha_fin    = datetime.now()
    fecha_inicio = fecha_fin - timedelta(days=dias)

    total_generados = 0
    batch           = []
    batch_size      = 500

    print("=" * 55)
    print("  SmartFlow GDL - Generador de Dataset Historico")
    print(f"  Periodo: {fecha_inicio.strftime('%d/%m/%Y')} "
          f"al {fecha_fin.strftime('%d/%m/%Y')}")
    print(f"  Dias: {dias} | Registros por hora: {registros_por_hora}")
    print(f"  Total estimado: {dias * 24 * registros_por_hora * len(INTERSECCIONES):,} registros")
    print("=" * 55)

    fecha_actual = fecha_inicio
    while fecha_actual < fecha_fin:
        # Clima estable por hora
        clima_hora = random.choices(
            CLIMAS,
            weights=[0.50, 0.25, 0.20, 0.05]
        )[0]

        for config in INTERSECCIONES:
            for _ in range(registros_por_hora):
                minuto  = random.randint(0, 59)
                segundo = random.randint(0, 59)
                ts = fecha_actual.replace(
                    minute=minuto, second=segundo, microsecond=0
                )

                lectura = generar_lectura(config, ts, clima_hora)
                batch.append(TrafficReadingDB(**lectura))

                if len(batch) >= batch_size:
                    db.bulk_save_objects(batch)
                    db.commit()
                    total_generados += len(batch)
                    batch = []
                    print(f"  Insertados: {total_generados:,} registros...")

        fecha_actual += timedelta(hours=1)

    if batch:
        db.bulk_save_objects(batch)
        db.commit()
        total_generados += len(batch)

    db.close()

    print("\n" + "=" * 55)
    print(f"  Dataset generado exitosamente")
    print(f"  Total registros: {total_generados:,}")
    print(f"  En Supabase -> tabla traffic_readings")
    print("=" * 55)


if __name__ == "__main__":
    limpiar_tabla()
    generar_dataset(dias=14, registros_por_hora=6)